[Unit]
Description=Rokugard ops API + admin
After=network.target postgresql.service

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/home/deploy/rokugard
EnvironmentFile=/home/deploy/rokugard/.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
